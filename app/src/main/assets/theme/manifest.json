{
  "manifest_version": 3,
  "name": "ZETA App Light Theme",
  "version": "6.0.0",
  "browser_specific_settings": {
    "gecko": {
      "id": "theme@zetatools.local"
    }
  },
  "host_permissions": [
    "https://zeta-ai.io/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://zeta-ai.io/*"
      ],
      "js": [
        "theme-default.js",
        "theme-loader.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "permissions": [
    "nativeMessaging",
    "nativeMessagingFromContent",
    "geckoViewAddons"
  ]
}
